{
  "bkcrack": {
    "name": "bkcrack",
    "license": "zlib",
    "licenseUrl": "https://github.com/kimci86/bkcrack/blob/master/license.txt",
    "approxSizeMb": 2,
    "page": "https://github.com/kimci86/bkcrack/releases/latest",
    "purpose": "known-plaintext",
    "exe": ["bkcrack.exe"],
    "auto": { "provider": "github", "repo": "kimci86/bkcrack", "assetPattern": "win(dows)?.*\\.zip$|.*windows.*\\.zip$" }
  },
  "hashcat": {
    "name": "hashcat",
    "license": "MIT",
    "licenseUrl": "https://github.com/hashcat/hashcat/blob/master/docs/license.txt",
    "approxSizeMb": 230,
    "page": "https://hashcat.net/hashcat/",
    "purpose": "gpu",
    "exe": ["hashcat.exe"],
    "auto": { "provider": "scrape", "page": "https://hashcat.net/hashcat/", "linkPattern": "/files/hashcat-[0-9.]+\\.7z", "base": "https://hashcat.net" }
  },
  "john": {
    "name": "John the Ripper (jumbo)",
    "license": "GPLv2+",
    "licenseUrl": "https://github.com/openwall/john/blob/bleeding-jumbo/doc/LICENSE",
    "approxSizeMb": 22,
    "page": "https://www.openwall.com/john/",
    "purpose": "cpu",
    "exe": ["run/john.exe", "john.exe"],
    "helperExe": { "zip2john": ["run/zip2john.exe", "zip2john.exe"] },
    "auto": { "provider": "scrape", "page": "https://www.openwall.com/john/", "linkPattern": "(?:k/)?john-[0-9][\\w.-]*-win64\\.7z", "base": "https://www.openwall.com/john/" }
  }
}
